# Local mutation development requires docker-compose.transaction.yml (rs0).
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
DB_NAME=niuva
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-development-password

# Secure cookies are automatic outside development/test. Domain is normally blank.
# Development only. Production startup rejects false.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# Exact local frontend origin. HTTPS is required outside explicit local/test mode.
PUBLIC_SITE_URL=http://localhost:3000

# Development-only fixture. Production requires an approved maintained dataset.
AUTH_PASSWORD_BLOCKLIST_PATH=config/password-blocklist.development.txt

# Development bootstrap only. Production remains gated on the approved benchmark,
# blocklist, migration, and rollback-floor evidence.
AUTH_ARGON2_WRITES_ENABLED=true

# At least 32 random bytes, supplied through the deployment secret store.
AUTH_SESSION_CSRF_KEY=replace-with-at-least-32-random-bytes

# Feature 1.7 stays disabled until Migration 010 and target operations are
# separately approved. Use a dedicated externally injected key; never JWT_SECRET.
AUTH_SECURITY_EVENTS_ENABLED=false
AUTH_EVENT_HMAC_KEY=
AUTH_EVENT_HMAC_KEY_VERSION=v1

# Comma-separated exact frontend origins. Never use * with credentialed requests.
CORS_ORIGINS=http://localhost:3000

# Enable only when the service runs behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

HRD_EMAIL=niuvamakerspace@gmail.com
APP_NAME=niuva

# Email notifications use Resend. Without a key, notifications remain in-app only.
RESEND_API_KEY=
SENDER_EMAIL=website@your-verified-domain.example

# File storage defaults to disabled. Local mode is development/demo/test only.
APP_ENV=development
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=.local-storage

# Tests only. CI supplies an isolated rs-test topology on port 27018.
MONGO_TRANSACTION_TEST_URL=mongodb://127.0.0.1:27018/?replicaSet=rs-test&directConnection=true

# Local development uses the replica set started by docker-compose.transaction.yml.
# Production must not enable mutations until the reviewed migration/readiness gates pass.
TRANSACTION_MUTATIONS_ENABLED=true

# Durable notification delivery is opt-in. Required capabilities fail readiness.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_REQUIRED=false
EMAIL_DELIVERY_REQUIRED=false

# Never enable outside isolated tests.
NIUVA_TEST_BEARER_AUTH=false
